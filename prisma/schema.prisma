generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CANDIDATE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    CandidateProfile?
  employerMember EmployerMember?
  sentMessages Message[] @relation("SentMessages")
  participants ConversationParticipant[]
}

model CandidateProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  location    String?
  yearsExperience Int  @default(0)
  resumeUrl   String?
  skills      CandidateSkill[]
  assessments AssessmentAttempt[]
  applications Application[]
  savedJobs   SavedJob[]
}

model Skill {
  id         String  @id @default(cuid())
  name       String  @unique
  category   String
  candidates CandidateSkill[]
  jobSkills  JobSkill[]
  assessments Assessment[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  level       SkillLevel @default(BEGINNER)
  verified    Boolean    @default(false)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill      @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
}

model Assessment {
  id        String @id @default(cuid())
  skillId   String
  skill     Skill  @relation(fields: [skillId], references: [id])
  title     String
  passScore Int    @default(70)
  durationMinutes Int @default(45)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
}

model AssessmentQuestion {
  id           String @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json
  correctIndex Int
  weight       Int @default(1)
}

model AssessmentAttempt {
  id           String   @id @default(cuid())
  assessmentId String
  candidateId  String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  answers      Json
  takenAt      DateTime @default(now())

  @@index([candidateId, assessmentId])
}

model Employer {
  id       String @id @default(cuid())
  name     String
  website  String?
  industry String?
  members  EmployerMember[]
  jobs     Job[]
}

model EmployerMember {
  id         String @id @default(cuid())
  userId     String @unique
  employerId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title      String?
}

model Job {
  id          String    @id @default(cuid())
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  description String
  location    String?
  workMode    WorkMode  @default(HYBRID)
  salaryMin   Int?
  salaryMax   Int?
  status      JobStatus @default(DRAFT)
  postedAt    DateTime?
  expiresAt   DateTime?
  skills      JobSkill[]
  applications Application[]
  savedBy     SavedJob[]

  @@index([status, postedAt])
  @@index([employerId])
  @@index([status, expiresAt])
}

model JobSkill {
  jobId      String
  skillId    String
  minLevel   SkillLevel @default(INTERMEDIATE)
  required   Boolean    @default(true)
  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}

model Application {
  id          String @id @default(cuid())
  jobId       String
  candidateId String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  matchScore  Float?
  coverLetter String?
  createdAt   DateTime @default(now())
  interviews  Interview[]

  @@unique([jobId, candidateId])
  @@index([candidateId])
}

model Interview {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  durationMinutes Int @default(45)
  meetingUrl    String?
  status        InterviewStatus @default(PROPOSED)

  @@index([applicationId, startsAt])
}

model SavedJob {
  candidateId String
  jobId       String
  savedAt     DateTime @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobId])
}

model Conversation {
  id           String @id @default(cuid())
  createdAt    DateTime @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  sentAt         DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, sentAt])
}
