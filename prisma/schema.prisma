generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum InterviewStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  RESCINDED
}

enum ReferralStatus {
  PENDING
  APPLIED
  HIRED
  EXPIRED
}

enum NotificationType {
  APPLICATION_UPDATE
  INTERVIEW_SCHEDULED
  INTERVIEW_REMINDER
  OFFER_RECEIVED
  NEW_MESSAGE
  JOB_ALERT
  ENDORSEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CANDIDATE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    CandidateProfile?
  employerMember EmployerMember?
  sentMessages Message[] @relation("SentMessages")
  participants ConversationParticipant[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  endorsementsGiven SkillEndorsement[]  @relation("EndorsementsGiven")
  reviewsWritten    Review[]            @relation("ReviewsWritten")
  referralsMade     Referral[]          @relation("ReferralsMade")
  feedbackGiven     InterviewFeedback[] @relation("FeedbackGiven")
  auditLogs         AuditLog[]
}

model CandidateProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  headline    String?
  location    String?
  yearsExperience Int  @default(0)
  resumeUrl   String?
  skills      CandidateSkill[]
  assessments AssessmentAttempt[]
  applications Application[]
  savedJobs   SavedJob[]
  educations   Education[]
  experiences  WorkExperience[]
  certifications Certification[]
  endorsements SkillEndorsement[]
  jobAlerts    JobAlert[]
  profileViews ProfileView[]
}

model Skill {
  id         String  @id @default(cuid())
  name       String  @unique
  category   String
  candidates CandidateSkill[]
  jobSkills  JobSkill[]
  assessments Assessment[]
  endorsements SkillEndorsement[]
}

model CandidateSkill {
  candidateId String
  skillId     String
  level       SkillLevel @default(BEGINNER)
  verified    Boolean    @default(false)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill      @relation(fields: [skillId], references: [id])

  @@id([candidateId, skillId])
}

model Assessment {
  id        String @id @default(cuid())
  skillId   String
  skill     Skill  @relation(fields: [skillId], references: [id])
  title     String
  passScore Int    @default(70)
  durationMinutes Int @default(45)
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]
}

model AssessmentQuestion {
  id           String @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  prompt       String
  options      Json
  correctIndex Int
  weight       Int @default(1)
}

model AssessmentAttempt {
  id           String   @id @default(cuid())
  assessmentId String
  candidateId  String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  score        Int
  passed       Boolean
  answers      Json
  takenAt      DateTime @default(now())

  @@index([candidateId, assessmentId])
}

model Employer {
  id       String @id @default(cuid())
  name     String
  website  String?
  industry String?
  members  EmployerMember[]
  jobs     Job[]
  reviews  Review[]
  profileViews ProfileView[]
}

model EmployerMember {
  id         String @id @default(cuid())
  userId     String @unique
  employerId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title      String?
}

model Job {
  id          String    @id @default(cuid())
  employerId  String
  employer    Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title       String
  description String
  location    String?
  workMode    WorkMode  @default(HYBRID)
  salaryMin   Int?
  salaryMax   Int?
  status      JobStatus @default(DRAFT)
  postedAt    DateTime?
  expiresAt   DateTime?
  skills      JobSkill[]
  applications Application[]
  savedBy     SavedJob[]
  referrals   Referral[]

  @@index([status, postedAt])
  @@index([employerId])
  @@index([status, expiresAt])
}

model JobSkill {
  jobId      String
  skillId    String
  minLevel   SkillLevel @default(INTERMEDIATE)
  required   Boolean    @default(true)
  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}

model Application {
  id          String @id @default(cuid())
  jobId       String
  candidateId String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUBMITTED)
  matchScore  Float?
  coverLetter String?
  createdAt   DateTime @default(now())
  interviews  Interview[]
  offers      Offer[]

  @@unique([jobId, candidateId])
  @@index([candidateId])
}

model Interview {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  durationMinutes Int @default(45)
  meetingUrl    String?
  status        InterviewStatus @default(PROPOSED)
  feedback      InterviewFeedback[]

  @@index([applicationId, startsAt])
}

model SavedJob {
  candidateId String
  jobId       String
  savedAt     DateTime @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobId])
}

model Conversation {
  id           String @id @default(cuid())
  createdAt    DateTime @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  sentAt         DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation("SentMessages", fields: [senderId], references: [id])
  attachments    MessageAttachment[]

  @@index([conversationId, sentAt])
}

model Education {
  id          String   @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  fieldOfStudy String?
  startYear   Int
  endYear     Int?
  gpa         Decimal? @db.Decimal(3, 2)

  @@index([candidateId, startYear])
  @@map("educations")
}

model WorkExperience {
  id          String    @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  workMode    WorkMode  @default(ONSITE)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  summary     String?

  @@index([candidateId, startDate])
  @@map("work_experiences")
}

model Certification {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name          String
  issuer        String
  credentialId  String?
  credentialUrl String?
  issuedAt      DateTime  @db.Date
  expiresAt     DateTime? @db.Date

  @@unique([candidateId, issuer, credentialId])
  @@index([expiresAt])
  @@map("certifications")
}

model SkillEndorsement {
  id          String   @id @default(cuid())
  candidateId String
  skillId     String
  endorserId  String
  note        String?
  createdAt   DateTime @default(now())
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id])
  endorser    User     @relation("EndorsementsGiven", fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId, endorserId])
  @@index([candidateId, skillId])
  @@map("skill_endorsements")
}

model Offer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  salary        Int
  currency      String      @default("USD")
  equityPercent Decimal?    @db.Decimal(5, 3)
  startDate     DateTime?   @db.Date
  status        OfferStatus @default(DRAFT)
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([applicationId, status])
  @@index([status, expiresAt])
  @@map("offers")
}

model InterviewFeedback {
  id            String   @id @default(cuid())
  interviewId   String
  reviewerId    String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  reviewer      User      @relation("FeedbackGiven", fields: [reviewerId], references: [id])
  technicalScore Int
  communicationScore Int
  recommendation Boolean
  comments      String?
  submittedAt   DateTime @default(now())

  @@unique([interviewId, reviewerId])
  @@map("interview_feedback")
}

model Review {
  id         String   @id @default(cuid())
  employerId String
  authorId   String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  author     User     @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  rating     Int
  title      String
  body       String
  anonymous  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([employerId, authorId])
  @@index([employerId, createdAt])
  @@map("reviews")
}

model Referral {
  id            String         @id @default(cuid())
  jobId         String
  referrerId    String
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  referrer      User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail  String
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  @@index([jobId, status])
  @@index([refereeEmail])
  @@map("referrals")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model JobAlert {
  id          String         @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  query       String
  location    String?
  workMode    WorkMode?
  minSalary   Int?
  frequency   AlertFrequency @default(DAILY)
  active      Boolean        @default(true)
  lastSentAt  DateTime?

  @@index([active, frequency])
  @@map("job_alerts")
}

model ProfileView {
  id          String   @id @default(cuid())
  candidateId String
  employerId  String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employer    Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  viewedAt    DateTime @default(now())

  @@index([candidateId, viewedAt])
  @@index([employerId])
  @@map("profile_views")
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  url       String
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
