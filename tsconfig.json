{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@skillbridge/types": ["packages/types/src"],
      "@skillbridge/utils": ["packages/utils/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
